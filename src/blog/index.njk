---
layout: layouts/page.njk
lang: id
title: Blog
intro: Catatan tentang operasional, otomasi, dan AI yang saya pakai sehari-hari.
permalink: "/blog/"
altUrl: "/en/blog/"
---
{% set t = i18n.id %}
{% set posts = collections.posts | byLang('id') | newestFirst %}

{% if posts.length %}
<div class="grid grid--2">
  {% for post in posts %}
  <a class="card card--link" href="{{ post.url }}">
    <h3>{{ post.data.title }}</h3>
    <p>{{ post.data.description }}</p>
    <div class="card__meta">
      <span class="muted">{{ post.date | readableDate('id') }}</span>
      {% for tag in post.data.tags %}{% if tag != 'posts' %}<span class="tag">{{ tag }}</span>{% endif %}{% endfor %}
    </div>
  </a>
  {% endfor %}
</div>
{% else %}
<p class="muted">{{ t.blog.empty }}</p>
{% endif %}
