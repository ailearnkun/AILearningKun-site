---
layout: layouts/base.njk
lang: id
permalink: "/"
altUrl: "/en/"
title: ""
description: "Kun — praktisi operasional properti di Bali yang membangun sistem AI untuk membuat operasional berjalan lebih efisien, terukur, dan konsisten."
---
{% set t = i18n.id %}

<!-- HERO -->
<section class="hero">
  <div class="wrap hero__inner">
    <span class="hero__label">{{ t.home.heroLabel }}</span>
    <h1>{{ t.home.heroTitle }}</h1>
    <p>{{ t.home.heroText }}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/kontak/">{{ t.cta.primary }}</a>
      <a class="btn btn--outline-light" href="/proyek/">{{ t.cta.secondary }}</a>
    </div>
  </div>
</section>

<!-- PILLARS -->
<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>{{ t.home.pillarsTitle }}</h2>
    </div>
    <div class="grid grid--3">
      {% for p in t.home.pillars %}
      <article class="card" data-reveal>
        <div class="card__icon">{{ loop.index }}</div>
        <h3>{{ p.title }}</h3>
        <p>{{ p.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- SELECTED WORK -->
<section class="section section--alt">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>{{ t.home.workTitle }}</h2>
      <p>{{ t.home.workText }}</p>
    </div>
    <div class="grid grid--3">
      {% for project in projects | newestFirst %}
        {% if project.featured %}
        <a class="card card--link" href="/proyek/{{ project.slug }}/" data-reveal>
          <h3>{{ project.title.id }}</h3>
          <p>{{ project.summary.id }}</p>
          <div class="card__meta">
            {% for s in project.stack | limit(3) %}<span class="tag">{{ s }}</span>{% endfor %}
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
    <p style="margin-top:2rem"><a href="/proyek/">{{ t.home.allWork }} &rarr;</a></p>
  </div>
</section>

<!-- LATEST POSTS -->
<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>{{ t.home.blogTitle }}</h2>
    </div>
    {% set idPosts = collections.posts | byLang('id') | newestFirst %}
    {% if idPosts.length %}
    <div class="grid grid--3">
      {% for post in idPosts | limit(3) %}
      <a class="card card--link" href="{{ post.url }}" data-reveal>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.description }}</p>
        <div class="card__meta"><span class="muted">{{ post.date | readableDate('id') }}</span></div>
      </a>
      {% endfor %}
    </div>
    <p style="margin-top:2rem"><a href="/blog/">{{ t.home.allPosts }} &rarr;</a></p>
    {% else %}
    <p class="muted">{{ t.blog.empty }}</p>
    {% endif %}
  </div>
</section>

<!-- BACKGROUND + CTA -->
<section class="section section--navy">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>{{ t.home.aboutTitle }}</h2>
      <p>{{ t.home.aboutText }}</p>
    </div>
    <div class="btn-row" data-reveal>
      <a class="btn btn--light" href="/kontak/">{{ t.cta.primary }}</a>
      <a class="btn btn--outline-light" href="/tentang/">{{ t.nav.about }}</a>
    </div>
  </div>
</section>
