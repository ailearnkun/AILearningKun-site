---
layout: layouts/base.njk
lang: id
pagination:
  data: services
  size: 1
  alias: service
permalink: "/layanan/{{ service.slug }}/"
eleventyComputed:
  title: "{{ service.title.id }}"
  description: "{{ service.summary.id }}"
  altUrl: "/en/services/{{ service.slug }}/"
---
{% from "partials/icons.njk" import icon %}
{% set t = i18n.id %}

<header class="page-head">
  <div class="wrap">
    <p class="eyebrow">{{ t.nav.services }}</p>
    <h1>{{ service.title.id }}</h1>
    <p>{{ service.summary.id }}</p>
  </div>
</header>

<section class="section">
  <div class="wrap">
    <div class="grid grid--2">
      <div>
        <h2>{{ t.services.problem }}</h2>
        <p>{{ service.problem.id }}</p>
      </div>
      <div>
        <h2>{{ t.services.outcome }}</h2>
        <p>{{ service.outcome.id }}</p>
      </div>
    </div>

    <div class="mt-3">
      <h2>{{ t.services.approach }}</h2>
      <ul class="prose">
        {% for step in service.approach.id %}<li>{{ step }}</li>{% endfor %}
      </ul>
    </div>

    <div class="card mt-3">
      <h3>{{ t.services.start }}</h3>
      <p>{{ service.start.id }}</p>
      <div class="btn-row mt-6">
        <a class="btn btn--primary" href="/kontak/">{{ t.cta.primary }}</a>
      </div>
    </div>

    {% if service.stack %}
    <div class="card__meta mt-2">
      {% for s in service.stack %}<span class="tag">{{ s }}</span>{% endfor %}
    </div>
    {% endif %}

    <p class="mt-5"><a href="/layanan/">{{ icon("arrow-left", 16) }} {{ t.nav.services }}</a></p>
  </div>
</section>
