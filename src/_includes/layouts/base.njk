<!DOCTYPE html>
<html lang="{{ lang or 'id' }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} — {% endif %}{{ site.brand }}</title>
  <meta name="description" content="{{ description or site.description[lang or 'id'] }}" />
  <meta name="author" content="{{ site.owner }}" />

  {% set canonical = site.url + (page.url | replace('/index.html', '/')) %}
  <link rel="canonical" href="{{ canonical }}" />

  {# Language alternates for SEO #}
  {% if altUrl %}
  <link rel="alternate" hreflang="{{ 'en' if lang == 'id' else 'id' }}" href="{{ site.url + altUrl }}" />
  {% endif %}
  <link rel="alternate" hreflang="{{ lang or 'id' }}" href="{{ canonical }}" />

  {# Open Graph / Twitter #}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{% if title %}{{ title }} — {% endif %}{{ site.brand }}" />
  <meta property="og:description" content="{{ description or site.description[lang or 'id'] }}" />
  <meta property="og:url" content="{{ canonical }}" />
  <meta property="og:site_name" content="{{ site.brand }}" />
  <meta name="twitter:card" content="summary_large_image" />

  {# Fonts: self-hosted, preloaded so the first paint is not font-blocked #}
  <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  {# Styles: single custom stylesheet (no framework payload) #}
  <link rel="stylesheet" href="/assets/css/style.css" />

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0a192f" />
</head>
<body>
  <a class="skip-link" href="#main">{{ 'Lewati ke konten' if (lang or 'id') == 'id' else 'Skip to content' }}</a>

  {% include "partials/nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
