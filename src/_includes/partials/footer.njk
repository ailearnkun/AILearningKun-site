{% from "partials/icons.njk" import icon %}
{% set t = i18n[lang or 'id'] %}
<footer class="footer">
  <div class="wrap">
    <div class="footer__inner">
      <div>
        <div class="footer__brand">{{ site.brand }}</div>
        <p class="mb-0 measure">{{ site.tagline[lang or 'id'] }}</p>
      </div>

      <div>
        <ul class="footer__links">
          {% for item in site.nav %}
            {% set url = item.url if (lang or 'id') == 'id' else item.urlEn %}
            <li><a href="{{ url }}">{{ t.nav[item.key] }}</a></li>
          {% endfor %}
        </ul>

        {% if site.social.github %}
        <p class="mb-0 mt-1">
          <a href="{{ site.social.github }}" target="_blank" rel="noopener">{{ icon("github", 16) }} GitHub</a>
        </p>
        {% endif %}
      </div>
    </div>

    <div class="footer__bottom">
      <span>&copy; {% year %} {{ site.brand }}. {{ t.footer.rights }}</span>
      <span>{{ t.footer.builtWith }} · <a href="{{ site.privacyUrl[lang or 'id'] }}">{{ t.footer.privacy }}</a></span>
    </div>
  </div>
</footer>
