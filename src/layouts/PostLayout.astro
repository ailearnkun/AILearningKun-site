---
import BaseLayout from './BaseLayout.astro';
import { render } from 'astro:content';

export interface Props {
  post: any;
  lang?: string;
}

const { post, lang = 'id' } = Astro.props;
const { Content } = await render(post);
const backUrl = lang === 'id' ? '/blog/' : '/en/blog/';
const backLabel = lang === 'id' ? 'Kembali ke blog' : 'Back to blog';
const dateStr = post.data.date.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout title={post.data.title} description={post.data.description} lang={lang}>
  <article class="post wrap">
    <p><a href={backUrl}>&larr; {backLabel}</a></p>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.date.toISOString()}>{dateStr}</time>
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}
    <div class="post__content">
      <Content />
    </div>
  </article>
</BaseLayout>
