---
import BaseLayout from '@/layouts/BaseLayout.astro';
import siteData from '@/data/site.json';
import { getCollection } from 'astro:content';
const t = {"lang": "en", "langLabel": "English", "switchTo": "Bahasa Indonesia", "switchUrl": "/", "nav": {"home": "Home", "services": "Services", "work": "Work", "blog": "Blog", "about": "About", "contact": "Contact"}, "cta": {"primary": "Get in Touch", "secondary": "View Work", "consult": "Book a Free Chat"}, "home": {"heroLabel": "Operations \u00d7 AI", "heroTitle": "Operations that run smoother, powered by AI", "heroText": "I help properties and businesses tighten up their operations with systems I build myself \u2014 from automated record-keeping to reports that arrive without being asked for.", "pillarsTitle": "What I do", "pillars": [{"icon": "settings", "title": "Operations Optimization", "text": "Structuring workflows, SOPs, and monitoring so daily operations don't depend on someone's memory."}, {"icon": "chart", "title": "Automation & Reporting", "text": "Connecting the tools you already use and automating repetitive work \u2014 reports come to you, not the other way around."}, {"icon": "cpu", "title": "Custom AI Systems", "text": "Building assistants and AI agents that handle real work: recording, monitoring, summarizing, and reminding."}], "workTitle": "Selected work", "workText": "Real systems already in use \u2014 not concepts.", "allWork": "See all work", "blogTitle": "Latest writing", "allPosts": "See all posts", "aboutTitle": "Background", "aboutText": "I work in rental property operations in Bali and build the AI systems I use daily myself. That combination means I know exactly where operations stall \u2014 and how to fix it."}, "services": {"title": "Services", "intro": "Three ways I can help \u2014 all grounded in real operational experience, not theory.", "problem": "The problem it solves", "approach": "Approach", "outcome": "Expected outcome", "start": "How to start", "ctaTitle": "Facing an operational challenge?", "ctaText": "Tell me your situation. I'll tell you honestly whether I can help or not."}, "work": {"title": "Work", "intro": "Systems I built and use myself. All running in production, not demos.", "context": "Context", "problem": "Challenge", "built": "What I built", "stack": "Stack", "result": "Result", "visit": "Visit"}, "blog": {"title": "Blog", "intro": "Notes on operations, automation, and the AI I use every day.", "readMore": "Read more", "minRead": "min read", "allTags": "All topics", "empty": "No posts yet.", "backToBlog": "Back to blog", "searchLabel": "Search posts", "searchPlaceholder": "Search by title, topic, or keyword...", "searchNoResults": "No posts match", "searchResultsOne": "1 post found", "searchResultsMany": "posts found", "searchClear": "Clear search", "searchHint": "Press Esc to clear"}, "about": {"title": "About", "intro": "A property operations practitioner in Bali who builds his own AI systems.", "backgroundTitle": "Background", "backgroundText": "I run operations for rental properties in Bali. This work taught me that the biggest problem is rarely a lack of effort \u2014 it's processes that depend on people's memory, reports that are always late, and repetitive work that eats up time.", "approachTitle": "How I work", "approachText": "I build AI systems to solve those problems, then use them myself every day. Because I'm the user, I know what genuinely helps and what just looks impressive.", "skillsTitle": "Skills", "skills": ["Rental property operations management", "Workflow automation & tool integration", "AI agent & assistant development", "Reporting and record-keeping automation", "Data integration (Google Workspace, APIs, databases)", "SOP design and operational monitoring"], "ctaTitle": "Let's talk", "ctaText": "Open to collaboration, consulting, and opportunities in operations and automation."}, "contact": {"title": "Contact", "intro": "Send a message \u2014 I usually reply within 24 hours.", "formName": "Name", "formEmail": "Email", "formMessage": "Message", "formSubmit": "Send Message", "formNote": "This form is secure. Your data is never shared with third parties.", "emailLabel": "Email", "whatsappLabel": "WhatsApp", "waCta": "Chat Directly on WhatsApp", "waPrefill": "Hi Kun, I'd like to ask about your automation/AI services.", "locationLabel": "Location", "responseTime": "Response time", "responseValue": "Usually within 24 hours", "success": "Thank you! Your message has been sent."}, "footer": {"rights": "All rights reserved.", "builtWith": "Built with Eleventy", "privacy": "Privacy Policy"}};
const featured = (await import('@/data/projects.json')).default.filter(p => p.featured).sort((a,b) => a.order - b.order);
const posts = (await getCollection('blogEn')).sort(
  (a,b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);
---

<BaseLayout title="" description={siteData.description.en} lang="en" altUrl="/">
  <section class="hero">
    <div class="wrap hero__inner">
      <span class="hero__label">{t.home.heroLabel}</span>
      <h1>{t.home.heroTitle}</h1>
      <p>{t.home.heroText}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/en/contact/">Contact Me</a>
        <a class="btn btn--outline-light" href="/en/work/">View Projects</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>{t.home.pillarsTitle}</h2>
      </div>
      <div class="grid grid--3">
        {t.home.pillars.map((p: any) => (
          <article class="card" data-reveal>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>{t.home.workTitle}</h2>
        <p>{t.home.workText}</p>
      </div>
      <div class="grid grid--3">
        {featured.map((project: any) => (
          <a class="card card--link" href={"/en/work/" + project.slug + "/"} data-reveal>
            <h3>{project.title.en}</h3>
            <p>{project.summary.en}</p>
            <div class="card__meta">
              {project.stack.slice(0,3).map((s: string) => <span class="tag">{s}</span>)}
            </div>
          </a>
        ))}
      </div>
      <p class="mt-2"><a href="/en/work/">{t.home.allWork} &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>{t.home.blogTitle}</h2>
      </div>
      {posts.length > 0 ? (
        <div class="grid grid--3">
          {posts.map((post: any) => (
            <a class="card card--link" href={"/en/blog/" + post.id + "/"} data-reveal>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="muted">{t.blog.empty}</p>
      )}
      <p class="mt-2"><a href="/en/blog/">{t.home.allPosts} &rarr;</a></p>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>{t.home.aboutTitle}</h2>
        <p>{t.home.aboutText}</p>
      </div>
      <div class="btn-row" data-reveal>
        <a class="btn btn--light" href="/en/contact/">Contact Me</a>
        <a class="btn btn--outline-light" href="/en/about/">{t.nav.about} &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
