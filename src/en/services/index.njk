---
layout: layouts/page.njk
lang: en
title: Services
intro: Three ways I can help — all grounded in real operational experience, not theory.
permalink: "/en/services/"
altUrl: "/layanan/"
---
{% set t = i18n.en %}
<div class="grid grid--3">
  {% for s in services %}
  <a class="card card--link" href="/en/services/{{ s.slug }}/">
    <div class="card__icon">{{ loop.index }}</div>
    <h3>{{ s.title.en }}</h3>
    <p>{{ s.summary.en }}</p>
    <div class="card__meta"><span class="tag">Read more &rarr;</span></div>
  </a>
  {% endfor %}
</div>

<div class="section-head" style="margin-top:3.5rem">
  <h2>{{ t.services.ctaTitle }}</h2>
  <p>{{ t.services.ctaText }}</p>
  <div class="btn-row" style="margin-top:1.25rem">
    <a class="btn btn--primary" href="/en/contact/">{{ t.cta.consult }}</a>
  </div>
</div>
