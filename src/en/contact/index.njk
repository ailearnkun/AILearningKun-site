---
layout: layouts/base.njk
lang: en
title: Contact
permalink: "/en/contact/"
altUrl: "/kontak/"
description: "Send a message — I usually reply within 24 hours."
---
{% from "partials/icons.njk" import icon %}
{% set t = i18n.en %}

<header class="page-head">
  <div class="wrap">
    <h1>{{ t.contact.title }}</h1>
    <p>{{ t.contact.intro }}</p>
  </div>
</header>

<section class="section">
  <div class="wrap">
    <div class="grid grid--2">

      <div>
        <form name="contact-en" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/en/thank-you/">
          <input type="hidden" name="form-name" value="contact-en" />
          <p class="is-hidden">
            <label>Do not fill: <input name="bot-field" /></label>
          </p>

          <div class="form-field">
            <label for="name">{{ t.contact.formName }}</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div class="form-field">
            <label for="email">{{ t.contact.formEmail }}</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="form-field">
            <label for="message">{{ t.contact.formMessage }}</label>
            <textarea id="message" name="message" required></textarea>
          </div>

          <button class="btn btn--primary" type="submit">{{ icon("send", 18) }} {{ t.contact.formSubmit }}</button>
          <p class="form-note">{{ t.contact.formNote }}</p>
        </form>
      </div>

      <div>
        <div class="contact-card">
          <dl class="m-0">
            <div class="contact-item">
              <dt>{{ icon("mail", 15) }} {{ t.contact.emailLabel }}</dt>
              <dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd>
            </div>
            {% if site.whatsapp %}
            <div class="contact-item">
              <dt>{{ icon("whatsapp", 15) }} {{ t.contact.whatsappLabel }}</dt>
              <dd><a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">Chat on WhatsApp</a></dd>
            </div>
            {% endif %}
            <div class="contact-item">
              <dt>{{ icon("location", 15) }} {{ t.contact.locationLabel }}</dt>
              <dd>{{ site.location }}</dd>
            </div>
            <div class="contact-item">
              <dt>{{ icon("clock", 15) }} {{ t.contact.responseTime }}</dt>
              <dd>{{ t.contact.responseValue }}</dd>
            </div>
          </dl>
        </div>
      </div>

    </div>
  </div>
</section>
