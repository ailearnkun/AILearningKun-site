---
layout: layouts/base.njk
lang: en
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/en/work/{{ project.slug }}/"
eleventyComputed:
  title: "{{ project.title.en }}"
  description: "{{ project.summary.en }}"
  altUrl: "/proyek/{{ project.slug }}/"
---
{% from "partials/icons.njk" import icon %}
{% set t = i18n.en %}

<header class="page-head">
  <div class="wrap">
    <p class="eyebrow">{{ t.nav.work }} · {{ project.year }}</p>
    <h1>{{ project.title.en }}</h1>
    <p>{{ project.summary.en }}</p>
  </div>
</header>

<section class="section">
  <div class="wrap">
    <div class="grid grid--2">
      <div>
        <h2>{{ t.work.context }}</h2>
        <p>{{ project.context.en }}</p>
      </div>
      <div>
        <h2>{{ t.work.problem }}</h2>
        <p>{{ project.problem.en }}</p>
      </div>
    </div>

    <div class="mt-3">
      <h2>{{ t.work.built }}</h2>
      <ul class="prose">
        {% for item in project.built.en %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>

    <div class="card mt-5">
      <h3>{{ t.work.result }}</h3>
      <p>{{ project.result.en }}</p>
    </div>

    <div class="mt-5">
      <h2 class="text-lg">{{ t.work.stack }}</h2>
      <div class="card__meta">
        {% for s in project.stack %}<span class="tag">{{ s }}</span>{% endfor %}
      </div>
    </div>

    <p class="mt-5"><a href="/en/work/">{{ icon("arrow-left", 16) }} {{ t.nav.work }}</a></p>
  </div>
</section>
